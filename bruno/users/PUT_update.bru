meta {
  name: PUT modifier un utilisateur (complet)
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/users/2
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "login": "paul",
    "password": "paul",
    "role": "USER"
  }
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("login correct", function() {
    expect(res.getBody().login).to.equal("paul");
  });
}
