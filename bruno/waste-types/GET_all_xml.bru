meta {
  name: GET tous les types de déchets (XML)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/waste-types?type=xml
  body: none
  auth: none
}

headers {
  Accept: application/xml
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("content-type XML", function() {
    expect(res.getHeader("content-type")).to.include("xml");
  });
}
